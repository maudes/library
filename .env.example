# Copy this file to .env and fill in the values. .env is never committed.

# Notion integration secret (starts with "ntn_")
NOTION_TOKEN=

# The 32-character id in your database's URL:
# https://www.notion.so/<workspace>/<THIS-PART>?v=...
NOTION_DATABASE_ID=

# Optional but recommended: Google Books API key (without one, Google
# often refuses requests and only Open Library is used).
GOOGLE_BOOKS_API_KEY=
